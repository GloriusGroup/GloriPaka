# --- Python ---------------------------------------------------------------- #
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/
.eggs/

# --- Virtual environments -------------------------------------------------- #
.venv/
venv/
.env
.env.*

# --- uv -------------------------------------------------------------------- #
# uv.lock IS committed (reproducible env); the cache is not.
.uv-cache/

# --- Tooling caches -------------------------------------------------------- #
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Docs ------------------------------------------------------------------ #
site/

# --- Generated outputs (regenerable; keep the repo lean) ------------------- #
cache/
results/
figures/*.pdf
figures/*.png

# --- Data (NOT redistributed here) ----------------------------------------- #
# Third-party datasets are cited, not published; the Ginkgo / PROPHET-Ab (GDPa)
# datapoints in particular must never be committed. Data is fetched locally (see
# data/README.md); nothing under data/ is tracked except the data-availability
# README and a curated, license-clear examples folder.
data/*
!data/README.md
!data/examples/
data/examples/**/*.pdb

# --- Secrets / API keys / credentials — NEVER commit ----------------------- #
*.pem
*.key
*_token
*_token.txt
*.secret
*apikey*
*api_key*
*API_KEY*
.secrets/
secrets/
**/*tabpfn*key*
**/tabpfn_token*

# --- OS / editor ----------------------------------------------------------- #
.DS_Store
.idea/
.vscode/
